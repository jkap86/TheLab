# Postgres connection string used by node-pg-migrate (npm run migrate:up/down).
# node-pg-migrate auto-loads this file's real counterpart (.env) and reads DATABASE_URL.
# Copy this file to .env and fill in your real credentials (.env is gitignored).
#
# Required in production: the server refuses to boot without it rather than let
# `pg` fall back to libpq's own defaults, and no background loop starts. In
# development it is optional — migrations are skipped and the loops stay down.
DATABASE_URL=postgres://user:password@localhost:5432/the_lab

# TLS mode for the Postgres connection. Leave unset to auto-detect:
#   disable          — no TLS; the default for localhost
#   verify-full      — TLS with the server certificate verified; the default for
#                      every other host
#   insecure-require — TLS with the certificate NOT verified. Encrypted but
#                      unauthenticated; only set this knowingly.
# An unrecognised value fails at startup rather than falling back.
# DATABASE_SSL_MODE=verify-full

# CA certificate (PEM) for verify-full against a provider whose chain isn't in
# Node's trust store. Literal \n sequences are unescaped, so a certificate
# pasted into a platform config UI works as-is.
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\nMIIB...\n-----END CERTIFICATE-----

# Deprecated, still honoured: `disable` maps to DATABASE_SSL_MODE=disable and
# `require` to `insecure-require`. Prefer DATABASE_SSL_MODE.
# DATABASE_SSL=require

# Connections one process may open (default 10). The limit that matters is the
# database *role's*, shared by every dyno, review app and psql session — 20 on a
# Heroku Essential plan — so give a multi-dyno deployment each dyno its share.
# DATABASE_POOL_MAX=10

# The deadline the platform enforces on a request, in milliseconds (default
# 30000, Heroku's router). Every database wait is a share of it, so lowering it
# tightens the connect, lock and statement timeouts together. Set it if the app
# sits behind something that gives up sooner.
# REQUEST_DEADLINE_MS=30000

# Expensive analytical database reads — Player Comps and the ADP boards — this
# process may run at once, across both tools together rather than each.
# Unset (the recommended state) it is derived from DATABASE_POOL_MAX: a third of
# the pool, so it follows the pool rather than needing to be kept in step with
# it. A value set here is a *request* and is clamped so heavy reads can never
# take the pool — normal application requests always keep a share of it — and
# junk, zero or a negative value falls back to the derived default.
# DB_HEAVY_READ_LIMIT=

# Deprecated, still honoured as aliases for DB_HEAVY_READ_LIMIT (tightest wins):
# these were the per-tool limits the shared budget absorbed.
# COMPS_READ_LIMIT=
# ADP_COMPUTE_LIMIT=

# Shared secret for the operator sync endpoints (POST /api/players/sync and
# POST /api/projections/sync), sent as the `x-internal-sync-secret` header.
# In production those routes answer 503 until this is set — they fail closed.
# On a dev server, leaving it unset lets them through so you can force a sync
# by hand.
# INTERNAL_SYNC_SECRET=change-me

# Pin the operating NFL season (4-digit year). Unset, it is read from Sleeper's
# state/nfl and cached for six hours, so a league-year rollover needs no deploy.
# NFL_SEASON_OVERRIDE=2026

# Set to `off` to disable *every* background loop in this process. This is the
# web process's switch in a web+worker deployment: run the same image twice,
# with BACKGROUND_JOBS=off on the dyno serving requests and nothing set on the
# one doing the crawling. The advisory locks stay in force either way, so a
# misconfigured second worker costs a skipped tick rather than a double scrape.
# Unset (the default), every loop runs in-process — which is what a single dyno
# and local development want.
# BACKGROUND_JOBS=off

# Per-loop switches, for turning one off without the others. Only the exact
# word `off` disables; anything else (including junk) runs, so a typo can't
# silently stop the database being filled.
# LEAGUE_CRAWLER=off      # the background league crawler (e.g. local dev)
# PROJECTIONS_SYNC=off    # weekly projections; each week is a ~5.6MB download
# STATS_SYNC=off          # weekly actual stat lines, likewise multi-megabyte
# KTC_SYNC=off            # KeepTradeCut values and the history backfill
# NFL_DRAFT_SYNC=off      # NFL draft positions; one ~2.6MB CSV twice a day

# Set to `on` to log a line per server-cache read (the full ADP board and the
# manager ranks): hit, miss, or coalesced onto a computation already running.
# Development only — these are the hottest reads in the app.
# CACHE_DEBUG=on
