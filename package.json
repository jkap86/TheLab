{
  "name": "thelab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm test",
    "migrate:up": "node --env-file=.env node_modules/.bin/node-pg-migrate up -m db/migrations",
    "migrate:down": "node --env-file=.env node_modules/.bin/node-pg-migrate down -m db/migrations",
    "migrate:create": "node-pg-migrate create -m db/migrations -j sql"
  },
  "dependencies": {
    "next": "16.3.3",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
